+/**
+ * Refresh failed in a way that proves the session is dead, as opposed to a
+ * timeout / offline blip / 5xx where the refresh token is still perfectly
+ * valid. Only the former may clear cookies and sign the user out.
+ */
+export class AuthRefreshRejectedError extends Error {}
+
+export function isDefinitiveRefreshRejection(error: unknown): boolean {
+  if (error instanceof AuthRefreshRejectedError) return true;
+  const status = (error as { response?: { status?: number } } | null)?.response
+    ?.status;
+  return status === 401 || status === 403;
+}
