# ─────────────────────────────────────────────────────────────────────────────
# Backend API — consumed by src/sdk/core/fetcher.ts
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Schedjuice Django backend, including the /api/v1 mount.
# Example (local backend on default port): http://localhost:8000/api/v1
# Example (production): https://api.schedjuice.com/api/v1
NEXT_PUBLIC_BASE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Web Push Notifications (VAPID)
# ─────────────────────────────────────────────────────────────────────────────

# VAPID public key for web push notifications (base64 URL-safe format)
# Generated on the backend and shared with the frontend for push subscriptions
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Universal Links / App Links (/.well-known) — set in deployment env (e.g. Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# Apple: Membership / Team ID from developer.apple.com (10 characters).
APPLE_TEAM_ID=

# Android: SHA-256 cert fingerprint(s) from Play Console → App signing, or keytool.
# Comma-separated if multiple. Use the signing key users install (Play App Signing).
ANDROID_SHA256_CERT_FINGERPRINT_SCHEDJUICE=
ANDROID_SHA256_CERT_FINGERPRINT_TEACHERSU=

# ─────────────────────────────────────────────────────────────────────────────
# File upload (tusd resumable upload server) — phase 2 (out of SDK foundation scope)
# Consumed by src/helpers/tusUpload.ts in the legacy app; not consumed by the
# new SDK foundation. Set anyway so phase 2 has it.
# ─────────────────────────────────────────────────────────────────────────────

# Origin of the tusd server. Defaults to http://localhost:1080 if unset (see
# next.config.js). Used directly by the upload helpers AND as the rewrite
# target for /files/* when NEXT_PUBLIC_ENABLE_REWRITES=1.
NEXT_PUBLIC_TUSD_ORIGIN=http://localhost:1080

# ─────────────────────────────────────────────────────────────────────────────
# JuiceBox media service — phase 2 (out of SDK foundation scope)
# Schedjuice's media / recordings service. Not consumed by the SDK foundation.
# ─────────────────────────────────────────────────────────────────────────────

# Origin of the JuiceBox service. Defaults to http://localhost:8800 if unset
# (see next.config.js). Used by the recordings + public-watch flows AND as
# the rewrite target for /attachments/* when NEXT_PUBLIC_ENABLE_REWRITES=1.
NEXT_PUBLIC_JUICEBOX_ORIGIN=http://localhost:8800

# Reserved for a future JuiceBox HTTP API. Not currently consumed anywhere
# in the FE; included here because it's already provisioned in deployment env.
NEXT_PUBLIC_JUICE_BOX_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Local dev convenience
# ─────────────────────────────────────────────────────────────────────────────

# Toggle for the Next.js rewrites in next.config.js (proxies /files/* to TUSD
# and /attachments/* to JuiceBox, avoiding CORS in local dev).
# Set to "1" to enable; auto-enabled when NODE_ENV !== "production".
NEXT_PUBLIC_ENABLE_REWRITES=

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Microsoft / MSAL config is NOT env-based.
# `authority` and `app_id` (client ID) come from the current Tenant object
# (GET /api/v1/organizations/public, resolved by the Host header). Each
# tenant has its own Azure app registration. See §14.2 (Auth + Tenants)
# in docs/superpowers/specs/2026-05-17-schedjuice-v2-api-sdk-brief.md.
# ─────────────────────────────────────────────────────────────────────────────

# PostHog Cloud US (pageviews; disabled when key unset)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_DASHBOARD_URL=https://us.posthog.com/project/<project-id>/dashboard/<dashboard-id>
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# Playwright browser smoke (`npm run test:browser`) — see e2e/README.md
# Start `npm run dev` first; globalSetup runs before Playwright webServer.
# ─────────────────────────────────────────────────────────────────────────────

# Frontend origin under test (must already be reachable)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# JWT login used by e2e/global-setup.ts (local test account; not a production secret)
PLAYWRIGHT_TEST_EMAIL=james@schedjuice.com
PLAYWRIGHT_TEST_PASSWORD=password123

# Unique text on exactly one editable student-payments row (status combobox + Delete)
PLAYWRIGHT_PAYMENT_FIXTURE_TEXT=

# Optional when default course/month filters hide the fixture row
PLAYWRIGHT_PAYMENT_FIXTURE_COURSE_ID=
PLAYWRIGHT_PAYMENT_FIXTURE_DATE=

# Optional: system browser channel (e.g. chrome). Leave unset for bundled Chromium.
# PLAYWRIGHT_CHANNEL=chrome
