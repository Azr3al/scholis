-        : null;
-    throw new ApiError(
-      res.status,
-      error?.code ?? 'unknown',
-      error?.message ?? 'Something went wrong.',
-    );
+    throw errorFrom(res.status, body);
   }
 
   return res.json() as Promise<T>;
