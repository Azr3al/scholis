+// The staff analogue of the launch above: the caller has already authenticated
+// this teacher on its own side, so Scholis hands back a link that opens a
+// session rather than asking them to prove themselves a second time. It cannot
+// create an account — see server/integrations/teacher-sso.ts.
+api.post('/integration/teacher-sso', zValidator('json', teacherSsoInput), async (c) => {
+  const ctx = authedContextFor(await actorFromRequest(c.req.raw));
+  return c.json(await mintTeacherSsoTicket(ctx, c.req.valid('json')), 201);
+});
