+          <p className="text-sm text-text-muted" role="status">
+            {ocrState.message}
+          </p>
+        ) : null}
+        {part.duplicateWarningId ? (
+          <p className="text-sm text-warning-foreground" role="status">
+            This transaction may already be saved as payment #{part.duplicateWarningId}.
