diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..0a5eeae
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,112 @@
+# Scholis — local development environment.
+#
+#   cp .env.example .env
+#
+# Both apps read this file: `pnpm dev` starts the API on :3001 and the web app
+# on :3000, and the web dev script loads it through dotenv-cli. Nothing here is
+# secret — real credentials live in the platform's environment, never in git.
+
+# ---------------------------------------------------------------------------
+# Database (apps/api)
+# ---------------------------------------------------------------------------
+# The only service that talks to Postgres. apps/web has no database dependency
+# at all; that is what keeps answer keys out of the browser bundle.
+DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholis
+
+# Optional. Bounds the connection pool; must be a positive integer when set.
+# DB_POOL_MAX=10
+
+# Optional. Override for a non-standard checkout layout.
+# MIGRATIONS_DIR=./packages/db/migrations
+
+# ---------------------------------------------------------------------------
+# Auth (apps/api)
+# ---------------------------------------------------------------------------
+# Both are required — the API refuses to boot without them. Generate with:
+#   openssl rand -hex 32
+# AUTH_SECRET signs better-auth sessions (teacher sign-in).
+AUTH_SECRET=dev-only-auth-secret-change-me-0000000000000000000000
+# ATTEMPT_TOKEN_SECRET signs the one-time student launch tickets that an
+# integrating platform (e.g. Schedjuice) redeems to send a taker into a paper.
+ATTEMPT_TOKEN_SECRET=dev-only-attempt-secret-change-me-000000000000000000
+
+# The origin a browser uses to reach Scholis. Read by the API, but in production
+# it is the WEB app's origin — set it to the same value as WEB_ORIGIN.
+#
+# It is better-auth's baseURL, so it decides where magic links point and whether
+# the session cookie is Secure and __Secure- prefixed; it also builds upload URLs
+# as <AUTH_URL>/api/files/<key>. All three must reach the browser through the web
+# app's /api proxy. Set it to the API's own subdomain and a teacher who clicks a
+# magic link gets a cookie scoped to that subdomain, which the web origin never
+# sends back — they land on /teacher signed out, and nothing logs why.
+#
+# http://localhost:3001 is fine in development only because cookies for localhost
+# ignore the port. Use https in production, or the cookie loses Secure.
+AUTH_URL=http://localhost:3001
+
+# Public origin of the web app. Trusted for CORS and better-auth CSRF, and the
+# origin teacher SSO links are built on. Equals AUTH_URL in production.
+WEB_ORIGIN=http://localhost:3000
+
+# ---------------------------------------------------------------------------
+# Mail (apps/api)
+# ---------------------------------------------------------------------------
+# 'console' prints the sign-in link to stdout, which is right for development
+# and refused in production. Set MAIL_PROVIDER=resend plus the two keys below
+# when running for real.
+MAIL_PROVIDER=console
+# RESEND_API_KEY=re_xxx
+# MAIL_FROM=Scholis <noreply@example.com>
+
+# ---------------------------------------------------------------------------
+# File storage (apps/api)
+# ---------------------------------------------------------------------------
+# 'railway' writes to a mounted volume. Railway sets the mount path itself;
+# set it by hand only when running the API outside Railway.
+STORAGE_PROVIDER=railway
+# RAILWAY_VOLUME_MOUNT_PATH=/var/data
+
+# ---------------------------------------------------------------------------
+# Dev-only routes (apps/api)
+# ---------------------------------------------------------------------------
+# Mounts /api/dev/* (org provisioning, fixtures). Requires BOTH a non-production
+# NODE_ENV and this exact value — forgetting it leaves the routes off, which is
+# the intended failure mode.
+SCHOLIS_DEV_ROUTES=enabled
+
+# ---------------------------------------------------------------------------
+# Web app (apps/web)
+# ---------------------------------------------------------------------------
+# Where the browser-side client points (apps/web/lib/api.ts).
+#
+# Unset means it defaults to http://localhost:3001, so the browser calls the API
+# cross-origin directly. That is fine in development — cookies are not isolated
+# by port, so a session set on localhost:3001 is still sent to localhost:3000.
+#
+# In production set it to the EMPTY STRING, not the API's public origin:
+#   NEXT_PUBLIC_API_URL=
+# Empty makes every call relative, so it goes through the rewrite below and the
+# session cookie lands first-party on the web origin. Setting it to
+# https://api.example.com instead would make that cookie third-party from the web
+# app's point of view and browsers would drop it — sign-in, magic links and
+# teacher SSO would all appear to succeed and then arrive anonymous.
+# NEXT_PUBLIC_API_URL=
+
+# Server-side rewrite target for /api/*. Read at BUILD time — Next writes the
+# resolved destination into routes-manifest.json, so changing it means rebuilding
+# the image, not just editing a variable.
+API_PROXY_TARGET=http://localhost:3001
+
+# ---------------------------------------------------------------------------
+# Tests
+# ---------------------------------------------------------------------------
+# Integration tests default to in-process PGlite (no database needed). Set this
+# to run the identical suite against a real Postgres, as CI does.
+# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholis_test
+
+# Playwright drives a running pair of services; start them with `pnpm dev` first.
+# E2E_WEB_URL=http://localhost:3000
+# E2E_API_URL=http://localhost:3001
+# The service worker only registers in a production build, so the offline specs
+# need `pnpm --filter @scholis/web build` and this flag.
+# E2E_PRODUCTION=1
diff --git a/.github/workflows/verify.yml b/.github/workflows/verify.yml
new file mode 100644
index 0000000..7276934
--- /dev/null
+++ b/.github/workflows/verify.yml
@@ -0,0 +1,89 @@
+# There was no CI in this repository, so every gate below only ever ran when
+# somebody remembered to run it. Each one is here because it caught something
+# real; the step comments say what.
+#
+# Deliberately absent, so the omission is a decision rather than an oversight:
+#
+#   - `pnpm format:check` fails on 61 Scholis source files today. Gating on it
+#     would make the first run of this workflow red for a reason that has nothing
+#     to do with whatever change triggered it. Format the tree first, then add it.
+#   - `pnpm test:e2e` (Playwright) needs browsers plus a running API and
+#     database. It has not been proven to pass in a runner, and an unrunnable job
+#     that is skipped or flaky teaches people to ignore red. Prove it locally,
+#     then add it as its own job.
+name: verify
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      # This repository once carried 469 conflict markers committed as literal
+      # text across 56 files -- 936 of them inside pnpm-lock.yaml, which also
+      # ended up with a duplicated `apps/web` importer block. Nothing installed,
+      # typechecked, linted or tested, and it sat on the default branch.
+      #
+      # Only `<<<<<<< ` and `>>>>>>> ` are matched. A bare `=======` line is
+      # deliberately excluded: Markdown setext headings are runs of `=` and would
+      # fail on legitimate prose. Every real conflict carries both angle-bracket
+      # markers, so ignoring the middle one loses nothing.
+      #
+      # The vendored Schedjuice trees are excluded. They are not workspace
+      # members and have their own conventions -- the same reason
+      # .prettierignore keeps `pnpm format` out of them.
+      - name: No committed merge conflict markers
+        run: |
+          if git grep -nE '^(<{7} |>{7} )' -- . \
+               ':(exclude)schedjuice-reimagined-fe' \
+               ':(exclude)schedjuice-reimagined-be'; then
+            echo "::error::Merge conflict markers are committed above. Resolve them before merging."
+            exit 1
+          fi
+
+      # No `version:` input. It reads `packageManager` from package.json, so CI
+      # cannot drift onto a different pnpm major than a local shell -- which
+      # matters because pnpm rewrites the lockfile when it disagrees with it.
+      - uses: pnpm/action-setup@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: pnpm
+
+      # --frozen-lockfile rather than a plain install: a lockfile that disagrees
+      # with package.json should fail here, not quietly resolve something new on
+      # the runner and hand back a green build of different code.
+      - run: pnpm install --frozen-lockfile
+
+      # typecheck -> lint -> arch -> test.
+      #
+      # No Postgres service container. The suites run against PGlite in-process,
+      # so there is nothing to connect to -- proven by running the whole thing
+      # with no .env file at all. Adding a container here would be cargo cult,
+      # and would hide the day a test genuinely starts needing a real server.
+      - run: pnpm verify
+
+      # Kept separate from `verify` because of a bug `verify` structurally could
+      # not see: apps/web built its fonts through next/font/google, which fetches
+      # from fonts.googleapis.com at build time and fails the build outright when
+      # it cannot reach it. apps/web/Dockerfile runs exactly that build, so the
+      # web image was unbuildable anywhere without that egress -- while every
+      # check in `verify` was green. The fonts are self-hosted now; this step is
+      # what stops either half of that regressing.
+      #
+      # It also exercises turbo's output caching. `build.outputs` once listed only
+      # `.next/**`, so a cache hit on @scholis/api#build replayed the log and
+      # restored no files, leaving dist/ absent for `start:prod`. dist/** is in
+      # the list now.
+      - run: pnpm build
