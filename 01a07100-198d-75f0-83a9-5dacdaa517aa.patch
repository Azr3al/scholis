+                          </Link>
+                        ) : (
+                          "—"
+                        )}
+                        {device.user?.email ? (
+                          <p className="text-xs text-text-muted">
+                            {device.user.email}
+                          </p>
+                        ) : null}
+                      </TableCell>
+                      <TableCell>{deviceLabel(device)}</TableCell>
+                      <TableCell className="text-text-muted">
+                        {osLabel(device)}
+                      </TableCell>
+                      <TableCell>
