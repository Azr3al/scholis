# Copy to `.env` and fill in values for local development.
# See README.md for product docs video upload setup.

DATABASE_URL=postgresql://user:password@localhost:5432/db
DEBUG=true
# Local dev: allow Google OAuth return_origin http://localhost:3000 (link + login flows).
IS_DEV=true
DEV_TENANT_DOMAIN=schedjuice.thiha.net
# Staging: pin tenant lookup when the frontend host differs from canonical domain_url.
# DEV_TENANT_DOMAIN=dev.schedjuice.com
# IS_DEV is only required for localhost OAuth bypass; not needed on Railway staging.
DJANGO_SECRET=change-me
JWT=change-me

# Platform secrets encryption (required for PlatformOpsSettings DB overrides)
PLATFORM_SECRETS_ENCRYPTION_KEY=

# Product docs video upload (GitHub Releases)
# Create a public repo and a PAT with repo scope (classic) or Contents + Releases write (fine-grained).
GITHUB_DOCS_VIDEO_REPO=owner/product-docs-videos
GITHUB_DOCS_VIDEO_TOKEN=
GITHUB_DOCS_VIDEO_RELEASE_TAG=videos

# Transactional email (Resend) — non-Microsoft tenants only
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mail.schedjuice.com
RESEND_FROM_NAME=Schedjuice
RESEND_REPLY_TO=

# Traffic analytics (PostHog Cloud US) — disabled unless POSTHOG_ENABLED=true
POSTHOG_ENABLED=false
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_API_SAMPLE_RATE=0.5
POSTHOG_ENVIRONMENT=development

# Google Sign-In (authorization-code flow — redirect URI only in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/google/oauth/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Public HTTPS base for Google Calendar push notifications (must end before /notify/)
GOOGLE_CALENDAR_WEBHOOK_BASE_URL=

# DigitalOcean Spaces (STORAGE_BACKEND=do)
# S3_BUCKET_NAME — physical DO Space only (e.g. schedjuice-dev), not the env folder name.
# S3_MEDIA_LOCATION / S3_STATIC_LOCATION — include env prefix when using one Space:
#   prod: schedjuice-prod/media-prod, schedjuice-prod/static-prod
#   dev:  schedjuice-dev/media-dev, schedjuice-dev/static-dev
# STORAGE_BACKEND=do
# S3_BUCKET_NAME=schedjuice-dev
# S3_KEY_ID=
# S3_SECRET=
# S3_MEDIA_LOCATION=schedjuice-dev/media-dev
# S3_STATIC_LOCATION=schedjuice-dev/static-dev
# S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# S3_CDN_DOMAIN=schedjuice-dev.sgp1.cdn.digitaloceanspaces.com
# S3_CUSTOM_DOMAIN=https://schedjuice-dev.sgp1.digitaloceanspaces.com
# Legacy fallback for boto endpoint when S3_ENDPOINT is unset; do not point at CDN.
