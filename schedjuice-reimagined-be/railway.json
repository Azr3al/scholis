{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "preDeployCommand": "/bin/sh scripts/railway_predeploy.sh",
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "/bin/sh -c \"exec $START_COMMAND\"",
    "restartPolicyMaxRetries": 10
  }
}