+from django.conf import settings
+from google.auth.transport import requests
+from google.oauth2 import id_token
+
+
+class GoogleTokenVerificationError(Exception):
+    pass
+
+
+class _TimedGoogleAuthRequest(requests.Request):
+    """google-auth Request defaults to a 120s timeout; bound it on the login path."""
+
+    def __call__(self, url, method="GET", body=None, headers=None, timeout=(5, 10), **kwargs):
+        if timeout is None:
+            timeout = (5, 10)
+        return super().__call__(
+            url, method=method, body=body, headers=headers, timeout=timeout, **kwargs
+        )
+
+
+def verify_google_id_token(token: str) -> dict:
+    client_id = (getattr(settings, "GOOGLE_OAUTH_CLIENT_ID", "") or "").strip()
+    if not client_id:
+        raise GoogleTokenVerificationError("Google sign-in is not configured.")
+
+    try:
+        return id_token.verify_oauth2_token(
+            token,
+            _TimedGoogleAuthRequest(),
+            audience=client_id,
+        )
+    except ValueError as exc:
+        raise GoogleTokenVerificationError(str(exc)) from exc
