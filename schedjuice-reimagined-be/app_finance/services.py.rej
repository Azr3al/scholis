+
+
+def schedule_user_payment_ocr_after_submit(
+    payment, tenant_schema, *, ocr_event_id=None
+):
+    """Skip async OCR when preview already filled txn id and amount (staff path)."""
+    has_prefilled_ocr = bool(
+        payment.transaction_id and payment.parsed_amount is not None
+    )
+    event_id = ocr_event_id
+    if not event_id and getattr(payment, "ocr_event_id", None):
+        event_id = str(payment.ocr_event_id)
+    if event_id and has_prefilled_ocr:
+        parsed_amount = (
+            payment.parsed_amount.amount if payment.parsed_amount is not None else None
+        )
+        resolve_ocr_correctness_on_create.delay(
+            event_id=str(event_id),
+            schema_name=tenant_schema,
+            user_payment_id=payment.id,
+            submitted_transaction_id=payment.transaction_id,
+            submitted_amount=parsed_amount,
+        )
+        return
+    if payment.screenshot and not has_prefilled_ocr:
+        extract_receiver_ss_text_data.delay(payment.id, tenant_schema)
