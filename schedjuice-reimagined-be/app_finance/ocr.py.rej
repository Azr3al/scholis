+def extract_kbz_reference_number(parsed_text: str) -> str | None:
+    if not parsed_text:
+        return None
+    labeled = re.search(
+        r"reference\s+number\s+(?<!\d)(\d{15})(?!\d)",
+        parsed_text,
+        re.IGNORECASE,
+    )
+    if labeled:
+        return labeled.group(1)
+    match = KBZ_REFERENCE_PATTERN.search(parsed_text)
+    return match.group(0) if match else None
+
+
