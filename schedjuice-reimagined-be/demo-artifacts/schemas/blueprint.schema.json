{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "terminology", "org_toggles", "academic_structure", "default_scenario_packs", "use_case_order"],
  "properties": {
    "id": { "type": "string" },
    "terminology": { "type": "object", "additionalProperties": { "type": "string" } },
    "org_toggles": { "type": "object" },
    "academic_structure": { "type": "object" },
    "default_scenario_packs": { "type": "array", "items": { "type": "string" } },
    "use_case_order": { "type": "array", "items": { "type": "string" } },
    "physical_campuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "latitude", "longitude"],
        "properties": {
          "name": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "geofence_radius_meters": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "org_toggles_campus": { "type": "object" }
  },
  "additionalProperties": false
}
