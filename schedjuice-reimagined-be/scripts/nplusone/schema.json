{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPlusOneCaptureSchemas",
  "definitions": {
    "event": {
      "type": "object",
      "required": ["ts", "model", "field", "message"],
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "schema_name": { "type": ["string", "null"] },
        "view": { "type": ["string", "null"] },
        "expand": { "type": ["string", "null"] },
        "query_count": { "type": ["integer", "null"] },
        "status_code": { "type": ["integer", "null"] },
        "model": { "type": "string" },
        "field": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "method",
        "path",
        "view",
        "model",
        "field",
        "schema_name",
        "expand",
        "count",
        "max_query_count",
        "run_ids"
      ],
      "properties": {
        "method": { "type": "string" },
        "path": { "type": "string" },
        "view": { "type": "string" },
        "model": { "type": "string" },
        "field": { "type": "string" },
        "schema_name": { "type": "string" },
        "expand": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "max_query_count": { "type": "integer", "minimum": 0 },
        "first_seen": { "type": ["string", "null"], "format": "date-time" },
        "last_seen": { "type": ["string", "null"], "format": "date-time" },
        "run_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sample_message": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "generated_at",
        "source_files",
        "total_events",
        "unique_groups",
        "groups"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "total_events": { "type": "integer", "minimum": 0 },
        "unique_groups": { "type": "integer", "minimum": 0 },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/definitions/group" }
        }
      },
      "additionalProperties": false
    }
  }
}
