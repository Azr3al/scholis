# Copy to .env for local development. Never commit .env.

# Postgres. On Railway this is a reference variable pointing at the database
# service over the private network: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://scholis:scholis@localhost:5432/scholis

# Auth.js (Phase 3). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth for teacher sign-in (Phase 3)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email sender (Phase 3)
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=
