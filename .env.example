# Scholis — local development environment.
#
#   cp .env.example .env
#
# Both apps read this file: `pnpm dev` starts the API on :3001 and the web app
# on :3000, and the web dev script loads it through dotenv-cli. Nothing here is
# secret — real credentials live in the platform's environment, never in git.

# ---------------------------------------------------------------------------
# Database (apps/api)
# ---------------------------------------------------------------------------
# The only service that talks to Postgres. apps/web has no database dependency
# at all; that is what keeps answer keys out of the browser bundle.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholis

# Optional. Bounds the connection pool; must be a positive integer when set.
# DB_POOL_MAX=10

# Optional. Override for a non-standard checkout layout.
# MIGRATIONS_DIR=./packages/db/migrations

# ---------------------------------------------------------------------------
# Auth (apps/api)
# ---------------------------------------------------------------------------
# Both are required — the API refuses to boot without them. Generate with:
#   openssl rand -hex 32
# AUTH_SECRET signs better-auth sessions (teacher sign-in).
AUTH_SECRET=dev-only-auth-secret-change-me-0000000000000000000000
# ATTEMPT_TOKEN_SECRET signs the one-time student launch tickets that an
# integrating platform (e.g. Schedjuice) redeems to send a taker into a paper.
ATTEMPT_TOKEN_SECRET=dev-only-attempt-secret-change-me-000000000000000000

# Public origin of the API. Used for magic links and as better-auth's baseURL.
AUTH_URL=http://localhost:3001

# Public origin of the web app. Trusted for CORS and better-auth CSRF.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Mail (apps/api)
# ---------------------------------------------------------------------------
# 'console' prints the sign-in link to stdout, which is right for development
# and refused in production. Set MAIL_PROVIDER=resend plus the two keys below
# when running for real.
MAIL_PROVIDER=console
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Scholis <noreply@example.com>

# ---------------------------------------------------------------------------
# File storage (apps/api)
# ---------------------------------------------------------------------------
# 'railway' writes to a mounted volume. Railway sets the mount path itself;
# set it by hand only when running the API outside Railway.
STORAGE_PROVIDER=railway
# RAILWAY_VOLUME_MOUNT_PATH=/var/data

# ---------------------------------------------------------------------------
# Dev-only routes (apps/api)
# ---------------------------------------------------------------------------
# Mounts /api/dev/* (org provisioning, fixtures). Requires BOTH a non-production
# NODE_ENV and this exact value — forgetting it leaves the routes off, which is
# the intended failure mode.
SCHOLIS_DEV_ROUTES=enabled

# ---------------------------------------------------------------------------
# Web app (apps/web)
# ---------------------------------------------------------------------------
# Where the browser-side client points (apps/web/lib/api.ts).
#
# Unset means it defaults to http://localhost:3001, so the browser calls the API
# cross-origin directly. That is fine in development — cookies are not isolated
# by port, so a session set on localhost:3001 is still sent to localhost:3000.
#
# In production set it to the EMPTY STRING, not the API's public origin:
#   NEXT_PUBLIC_API_URL=
# Empty makes every call relative, so it goes through the rewrite below and the
# session cookie lands first-party on the web origin. Setting it to
# https://api.example.com instead would make that cookie third-party from the web
# app's point of view and browsers would drop it — sign-in, magic links and
# teacher SSO would all appear to succeed and then arrive anonymous.
# NEXT_PUBLIC_API_URL=

# Server-side rewrite target for /api/*. Read at BUILD time — Next writes the
# resolved destination into routes-manifest.json, so changing it means rebuilding
# the image, not just editing a variable.
API_PROXY_TARGET=http://localhost:3001

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Integration tests default to in-process PGlite (no database needed). Set this
# to run the identical suite against a real Postgres, as CI does.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholis_test

# Playwright drives a running pair of services; start them with `pnpm dev` first.
# E2E_WEB_URL=http://localhost:3000
# E2E_API_URL=http://localhost:3001
# The service worker only registers in a production build, so the offline specs
# need `pnpm --filter @scholis/web build` and this flag.
# E2E_PRODUCTION=1
